<Window x:Class="Pawlet.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pawlet library"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,8" />
      <CheckBox Content="Pause" IsChecked="{Binding Pause}" Margin="0,2" />
      <CheckBox Content="Animate idle" IsChecked="{Binding AnimateIdle}" Margin="0,2" />
      <CheckBox Content="Click-through" IsChecked="{Binding ClickThrough}" Margin="0,2" />
      <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,2" />
      <TextBlock Text="Hover reaction" Margin="0,8,0,2" />
      <ComboBox x:Name="HoverReactionBox" Margin="0,0,0,8" />
      <TextBlock Text="Scale" Margin="0,4,0,0" />
      <Slider Minimum="0.25" Maximum="1.75" TickFrequency="0.05" IsSnapToTickEnabled="True"
              Value="{Binding Scale, Mode=TwoWay}" />
      <TextBlock Text="Opacity" Margin="0,4,0,0" />
      <Slider Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
              Value="{Binding Opacity, Mode=TwoWay}" />
      <TextBlock Text="Speed" Margin="0,4,0,0" />
      <Slider Minimum="0.5" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
              Value="{Binding Speed, Mode=TwoWay}" />
      <TextBlock Text="Seconds between animations" Margin="0,4,0,0" />
      <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding AnimationIntervalSeconds, Mode=TwoWay}" />
    </StackPanel>

    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="Your minis" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="Import…" Width="88" HorizontalAlignment="Right" Click="OnImportClick" />
      </DockPanel>
      <ListBox x:Name="PetList" HorizontalContentAlignment="Stretch">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,4">
              <Button DockPanel.Dock="Right" Width="72" Margin="8,0,0,0"
                      Content="{Binding ActionLabel}"
                      Tag="{Binding Directory}"
                      Click="OnShowHideClick" />
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Id}" Foreground="Gray" FontSize="11" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</Window>

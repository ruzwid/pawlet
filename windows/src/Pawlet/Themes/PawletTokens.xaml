<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="PawletCanvasColor">#F8F8F2</Color>
  <Color x:Key="PawletSurfaceColor">#FFFFFB</Color>
  <Color x:Key="PawletStageColor">#F0F1E6</Color>
  <Color x:Key="PawletSecondaryColor">#66685D</Color>
  <Color x:Key="PawletBorderColor">#DDDED4</Color>
  <Color x:Key="PawletAccentColor">#627000</Color>
  <Color x:Key="PawletButtonColor">#627000</Color>
  <Color x:Key="PawletControlHighlightColor">#292A25</Color>
  <Color x:Key="PawletButtonInkColor">#FFFFFB</Color>
  <Color x:Key="PawletInkColor">#292A25</Color>
  <Color x:Key="PawletSidebarColor">#F1F2E9</Color>
  <Color x:Key="PawletSwitchOffColor">#E2E4D8</Color>
  <Color x:Key="PawletSwitchBorderColor">#7A7D73</Color>
  <Color x:Key="PawletSwitchThumbOnColor">#FFFFFB</Color>
  <Color x:Key="PawletSwitchThumbOffColor">#73766A</Color>

  <SolidColorBrush x:Key="PawletCanvasBrush" Color="{StaticResource PawletCanvasColor}" />
  <SolidColorBrush x:Key="PawletSurfaceBrush" Color="{StaticResource PawletSurfaceColor}" />
  <SolidColorBrush x:Key="PawletStageBrush" Color="{StaticResource PawletStageColor}" />
  <SolidColorBrush x:Key="PawletSecondaryBrush" Color="{StaticResource PawletSecondaryColor}" />
  <SolidColorBrush x:Key="PawletBorderBrush" Color="{StaticResource PawletBorderColor}" />
  <SolidColorBrush x:Key="PawletAccentBrush" Color="{StaticResource PawletAccentColor}" />
  <SolidColorBrush x:Key="PawletButtonBrush" Color="{StaticResource PawletButtonColor}" />
  <SolidColorBrush x:Key="PawletControlHighlightBrush" Color="{StaticResource PawletControlHighlightColor}" />
  <SolidColorBrush x:Key="PawletButtonInkBrush" Color="{StaticResource PawletButtonInkColor}" />
  <SolidColorBrush x:Key="PawletInkBrush" Color="{StaticResource PawletInkColor}" />
  <SolidColorBrush x:Key="PawletSidebarBrush" Color="{StaticResource PawletSidebarColor}" />
  <SolidColorBrush x:Key="PawletSwitchOffBrush" Color="{StaticResource PawletSwitchOffColor}" />
  <SolidColorBrush x:Key="PawletSwitchBorderBrush" Color="{StaticResource PawletSwitchBorderColor}" />
  <SolidColorBrush x:Key="PawletSwitchThumbOnBrush" Color="{StaticResource PawletSwitchThumbOnColor}" />
  <SolidColorBrush x:Key="PawletSwitchThumbOffBrush" Color="{StaticResource PawletSwitchThumbOffColor}" />

  <Style x:Key="PawletPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PawletButtonBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PawletButtonInkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PawletButtonBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PawletInkBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PawletOutlineButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource PawletAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PawletAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PawletStageBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PawletVisibilityButtonStyle" TargetType="Button" BasedOn="{StaticResource PawletOutlineButtonStyle}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsVisible}" Value="True">
        <Setter Property="Background" Value="{StaticResource PawletButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PawletButtonInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PawletButtonBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
